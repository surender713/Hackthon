{
  "manifest_version": 3,
  "name": "Media Authenticity Plugin",
  "version": "3.0.0",
  "description": "Detect AI-generated text using a local authenticity analysis backend.",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
